{
  "name": "@t4lly/opencode-version-adapter",
  "version": "0.1.0",
  "description": "Capability-driven compatibility boundary for OpenCode plugin API generations.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node scripts/run-compiled-tests.mjs",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "compatibility",
    "adapter"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
